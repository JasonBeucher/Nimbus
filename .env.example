# Jellyfin : Tableau de bord > Clés API > +
JELLYFIN_URL=http://192.168.1.11:8096
JELLYFIN_API_KEY=change-moi
# Nom de ton utilisateur Jellyfin (vide = premier admin)
JELLYFIN_USER=
PORT=3000
# Découverte (optionnel) : clé API TMDB (themoviedb.org > Paramètres > API), clé v3 ou jeton v4
TMDB_API_KEY=
# Envoi vers Radarr / Sonarr (Paramètres > Général > Clé API). *_PROFILE : nom du profil de qualité (vide = le premier)
RADARR_URL=http://192.168.1.11:7878
RADARR_API_KEY=
RADARR_PROFILE=
SONARR_URL=http://192.168.1.11:8989
SONARR_API_KEY=
SONARR_PROFILE=
# IA (optionnel) : serveur compatible OpenAI par défaut. Route, modèle et clé se règlent aussi par tâche dans Réglages.
AI_URL=http://192.168.1.89:8080/v1
# Modèle à utiliser (vide = celui chargé sur le serveur)
AI_MODEL=
